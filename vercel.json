{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?route=health"
    },
    {
      "source": "/v1/models",
      "destination": "/api?route=models"
    },
    {
      "source": "/v1/providers",
      "destination": "/api?route=providers"
    },
    {
      "source": "/doctor",
      "destination": "/api?route=doctor"
    },
    {
      "source": "/v1/chat/completions",
      "destination": "/api?route=chat"
    },
    {
      "source": "/java/api/v1",
      "destination": "/api?route=java-chat"
    },
    {
      "source": "/java/api/v1/chat/completions",
      "destination": "/api?route=java-chat"
    },
    {
      "source": "/java/v1",
      "destination": "/api?route=java-chat"
    },
    {
      "source": "/java/v1/chat/completions",
      "destination": "/api?route=java-chat"
    },
    {
      "source": "/v1/responses/chat/completions",
      "destination": "/api?route=responses-chat"
    },
    {
      "source": "/v1/responses",
      "destination": "/api?route=responses"
    },
    {
      "source": "/v1/responses/:path*",
      "destination": "/api?route=responses&path=:path*"
    }
  ]
}
