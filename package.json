{
  "name": "risu-zai-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-windows.ps1",
    "deps:py": "node ./scripts/run-python.mjs -m pip install --target pydeps -r requirements.txt",
    "dev": "node ./scripts/run-python.mjs ./py/server.py",
    "dev:node": "node ./local-server.js",
    "codex:catalog": "node ./scripts/run-python.mjs ./scripts/generate-codex-catalog.py",
    "check": "node ./scripts/check.js",
    "cloudflare:dev": "wrangler dev cloudflare/worker.mjs",
    "cloudflare:deploy": "wrangler deploy cloudflare/worker.mjs",
    "cloudflare:login": "wrangler login"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vercel": "^50.37.3",
    "wrangler": "^4.83.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.3",
    "chrome-remote-interface": "^0.34.0"
  }
}
